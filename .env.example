# Токен бота — получи у @BotFather в Telegram (команда /newbot)
TELEGRAM_BOT_TOKEN=вставь_сюда_токен_от_BotFather

# Ключ Gemini API — получи бесплатно на https://ai.google.dev/ (Get API key)
GEMINI_API_KEY=вставь_сюда_ключ_с_ai.google.dev

# Модель Gemini. Если не работает — зайди на ai.google.dev и проверь
# актуальное название доступной модели, названия иногда меняются
GEMINI_MODEL=gemini-2.5-flash

# Твой числовой Telegram ID — узнай у @userinfobot (команда /start)
ADMIN_ID=вставь_сюда_свой_telegram_user_id

# Публичный HTTPS-адрес твоего запущенного backend (см. инструкцию про
# туннель ниже). Обновляй при каждом перезапуске туннеля.
WEBAPP_URL=вставь_сюда_https_ссылку_с_ngrok_или_localtunnel
